# --- CONFIGURAÇÕES DO DJANGO ---
# Gere uma chave nova em: https://djecrety.ir/ (ou use uma string aleatória)
SECRET_KEY=django-insecure-substitua-por-uma-chave-real
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRES) ---
# Se estiver usando Docker, o HOST deve ser o nome do serviço no docker-compose (ex: db)
POSTGRES_DB=staff_sales_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CONFIGURAÇÕES DE FRONTEND (OPCIONAL) ---
# Caso precise apontar a URL da API dinamicamente no React
VITE_API_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://SEU_IP,http://localhost:8000